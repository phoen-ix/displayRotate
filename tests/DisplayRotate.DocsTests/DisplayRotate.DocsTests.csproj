<Project Sdk="Microsoft.NET.Sdk">

  <!-- The docs screenshot tour (scripts/docs-screenshots.sh): builds the app's real windows and
       saves them as PNGs. Also the Settings dialog's tests (SettingsFormTests). It needs Windows
       and a desktop session, so it stays out of DisplayRotate.slnx, whose tests run on Linux too. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DisplayRotate.DocsTests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/DisplayRotate/DisplayRotate.csproj" />
  </ItemGroup>

</Project>
