<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- A warning here means the code isn't doing what it reads like it does. NuGet advisories
         stay warnings: CI's audit step fails on them explicitly, and one against a transitive
         package four levels down should not turn an unrelated build red. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904;$(WarningsNotAsErrors)</WarningsNotAsErrors>

    <!-- Placeholder only: CI injects the real version via -p:Version (ci.yml, release job).
         Local builds show an obviously-dev v0.0.0 instead of a stale-looking number, and the
         updater never offers to "update" a development build. The app reads it back with
         Assembly.GetName().Version (DisplayRotate.Core/ProductInfo.cs). -->
    <Version>0.0.0-dev</Version>

    <Product>DisplayRotate</Product>
    <Company>phoen-ix</Company>
    <Authors>phoen-ix</Authors>
    <Copyright>Copyright (c) 2025 DisplayRotate contributors</Copyright>

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Lets the WinForms project restore and build on a Linux CI runner or dev box.
         The exe only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
