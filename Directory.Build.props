<Project>

  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.Common.props" />

  <PropertyGroup>
    <!-- Placeholder only: CI injects the real version via -p:Version (ci.yml, release job).
         Local builds show an obviously-dev v0.0.0 instead of a stale-looking number, and the
         updater never offers to "update" a development build. The app reads it back with
         Assembly.GetName().Version (DisplayRotate.Core/ProductInfo.cs). -->
    <Version>0.0.0-dev</Version>

    <Product>DisplayRotate</Product>
    <Company>phoen-ix</Company>
    <Authors>phoen-ix</Authors>
    <Copyright>Copyright (c) 2025 DisplayRotate contributors</Copyright>

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
